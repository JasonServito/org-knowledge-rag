# Copy to .env (gitignored) and fill in values for local development.
# Each variable is added here in the same change as the settings code that reads it.

# Matches compose.yaml (local-only credentials, host port 5433).
DATABASE_URL=postgresql://orgknow:orgknow@localhost:5433/orgknow

# Seconds GET /ready waits for a database connection before reporting 503.
DB_CONNECT_TIMEOUT_S=2

# Where `make seed` reads the releases from. Relative to the repo root; the default is the
# committed manifest.
# CORPUS_MANIFEST_PATH=config/corpus_manifest.yaml

# `make test-int` migrates and tests a separate database, `orgknow_test` (created by `make up`),
# so the dev database's ingested rows never collide with test rows. The Makefile holds the
# default; override it in the shell (Make doesn't read this file), as CI does.
# TEST_DATABASE_URL=postgresql://orgknow:orgknow@localhost:5433/orgknow_test

# Where spikes/fetch.py keeps partial clones of the corpus repos; `make ingest` reads them.
# Must be outside this repo. `~` is expanded. spikes/fetch.py reads it only from the shell
# environment (`uv run` doesn't load .env), so export it there too.
# CORPUS_CACHE_DIR=~/corpus_cache/org-knowledge-rag

# The SHAs `make ingest` reads (written by spikes/fetch.py). Relative to the repo root.
# CORPUS_LOCK_PATH=config/corpus_manifest.lock.yaml

# Which `scopes:` entry of the manifest `make ingest` reads: full (the default) or s04.
# INGEST_SCOPE=full

# KEP claim synonyms (ADR-003 D5): `GA` -> `stable` is the only one. JSON object.
# CLAIM_SYNONYMS={"GA": "stable"}

# The largest chunk body `make ingest` writes, in tokens estimated as characters / 4 (S04-R1
# decision 5). Only versions with no chunks are chunked, so a new value applies to versions
# stored after the change.
# CHUNK_MAX_TOKENS=512

# `make embed` calls the Voyage API with this key (paid). Unset: `make embed` stops with a message.
# Never commit it; tests use a fake embedder and never call Voyage.
# VOYAGE_API_KEY=

# The embeddings endpoint and model. Vectors are stored under the model name, so a new model
# embeds every text again (the old vectors stay).
# VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
# EMBEDDING_MODEL=voyage-4-large

# One request holds at most this many texts and estimated tokens (characters / 4). A single text
# over the token budget is sent alone.
# EMBED_BATCH_MAX_TEXTS=128
# EMBED_BATCH_MAX_TOKENS=60000

# `make embed` refuses to start when the texts it would send exceed this many estimated tokens.
# EMBED_MAX_TOKENS_PER_RUN=2000000

# How many chunk texts retrieval returns per question, in every mode: 1 to 40, and at most
# HNSW_EF_SEARCH.
# RETRIEVAL_TOP_K=10

# Which retrieval `orgknow ask` and the eval use: dense (the nearest vectors), hybrid (the
# nearest vectors and the best full-text matches, fused with RRF), rerank (hybrid's whole fused
# pool, reordered by a local cross-encoder; loads torch and the model), temporal (rerank, with
# both searches filtered by the question's route: CURRENT keeps current text only, HISTORY with a
# release or year keeps texts valid in it; one router call per `orgknow ask`) or authority
# (temporal, then the reranked texts reordered by authority weights for the route's mode: see
# AUTHORITY_BOOST). Authority is the default since S09-T8's eval (docs/evaluation.md).
# RETRIEVAL_MODE=authority

# Hybrid, rerank, temporal and authority: how many texts each search (dense and lexical) returns
# before fusion: 1 to 1000, and at most HNSW_EF_SEARCH.
# RETRIEVAL_CANDIDATES=20

# Hybrid, rerank, temporal and authority: RRF's k (at least 1). Rank r in one list adds
# 1 / (k + r) to a text's fused score.
# RRF_K=60

# The HNSW search width (pgvector's hnsw.ef_search) every dense search uses, in every mode: 1 to
# 1000, and at least RETRIEVAL_TOP_K and RETRIEVAL_CANDIDATES (an HNSW index scan returns at most
# this many rows; wider is closer to an exact scan).
# HNSW_EF_SEARCH=100

# Rerank, temporal and authority: the cross-encoder (ADR-008), a Hugging Face model at a pinned
# revision (a commit SHA).
# The first rerank run downloads it (1.1 GB) into the Hugging Face cache, outside this repo.
# RERANK_MODEL=BAAI/bge-reranker-base
# RERANK_REVISION=2cfc18c9415c912f9d8155881c133215df768a70

# Rerank, temporal and authority: the most tokens of each (question, text) pair the model reads,
# 1 to 512 (the model's limit; a longer text is cut, keeping its start), and how many pairs it
# scores per batch, 1 to 256.
# RERANK_MAX_LENGTH=512
# RERANK_BATCH_SIZE=8

# Temporal and authority: how many releases a HISTORY question's window is widened by at each
# closed end, 0 to 5 (ADR-003 D4's ±1). With 1, "until 1.27" searches until 1.28.
# HISTORY_WINDOW_SLACK=1

# Authority: the reranker's probability (0 to 1) of each text is multiplied by AUTHORITY_BOOST
# (1 to 4) for a source the route's mode trusts (CURRENT: docs pages, the feature-gate reference
# and release notes valid in the latest release; CHANGE: release notes; WHY: a KEP's Motivation
# or Alternatives section, blog posts, governance docs), by AUTHORITY_DEMOTE (above 0, at most 1)
# for a weak one (CURRENT: blog posts; WHY: the feature-gate reference), and by 1 otherwise; the
# texts are then reordered by that product. 1 and 1 give temporal's order.
# AUTHORITY_BOOST=1.25
# AUTHORITY_DEMOTE=0.8

# The answer step (ADR-006 D1): the model, its effort (low, medium, high, xhigh or max: how much
# it reasons first) and the most tokens one answer may use, reasoning included (billed as output).
# GENERATION_MAX_TOKENS is 1 to 21333: above that, the SDK refuses a non-streaming call.
# GENERATION_MODEL=claude-opus-5-5
# GENERATION_EFFORT=medium
# GENERATION_MAX_TOKENS=16000

# The model's prices in US dollars per million tokens (ADR-006 D1), for the eval summary's cost
# per question. Output tokens include reasoning. Change them with the model or its price list.
# GENERATION_PRICE_INPUT_USD_PER_MTOK=4.0
# GENERATION_PRICE_OUTPUT_USD_PER_MTOK=20.0

# The query router (ADR-009 D1): one call per question sorts it into a mode (CURRENT, HISTORY,
# CHANGE, WHY) and copies the release or year it names. The model, its effort (low, medium, high,
# xhigh or max) and the most tokens one route may use, reasoning included: 1 to 16000.
# ROUTER_MODEL=claude-opus-5-5
# ROUTER_EFFORT=low
# ROUTER_MAX_TOKENS=4096

# The router model's prices in US dollars per million tokens, for `make eval-routes`'s cost.
# ROUTER_PRICE_INPUT_USD_PER_MTOK=4.0
# ROUTER_PRICE_OUTPUT_USD_PER_MTOK=20.0

# The answer step and the router call the Anthropic API with this key (paid). Never commit it;
# tests use a fake generator and a fake router, and never call Anthropic.
# ANTHROPIC_API_KEY=

# Langfuse tracing (ADR-006 D3): `orgknow ask` sends one trace per question to Langfuse Cloud.
# Leave either key unset and `ask` prints "tracing off" and still answers. Never commit the keys;
# tests never call Langfuse. The base URL defaults to the EU region; for the US region use
# https://us.cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# The golden set `make eval-check` validates and checks against the database, and `make eval`
# runs (ADR-007). Relative to the repo root.
# EVAL_GOLDEN_PATH=eval/golden_set/v0.yaml

# Where `make eval` and `make eval-smoke` write one results folder per run, and the ablation table
# (ablation.md) rebuilt from them. Relative to the repo root.
# EVAL_RESULTS_DIR=eval/results

# The stored question vectors, one file per embedding model (<EMBEDDING_MODEL>.json, keyed by the
# sha256 of each question's text). A run embeds only questions with no vector here, so a re-run
# makes 0 Voyage requests and retrieves exactly the same chunks. Relative to the repo root.
# EVAL_VECTORS_DIR=eval/question_vectors

# The stored question routes, one file per router model (<ROUTER_MODEL>.json, keyed like the
# vectors, with the router prompt's hash). `make eval-routes` routes only the questions with no
# route here, so a re-run makes 0 calls. Relative to the repo root.
# EVAL_ROUTES_DIR=eval/question_routes
