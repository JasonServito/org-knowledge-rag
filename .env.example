# Copy to .env (gitignored) and fill in values for local development.
# Each variable is added here in the same change as the settings code that reads it.

# Matches compose.yaml (local-only credentials, host port 5433).
DATABASE_URL=postgresql://orgknow:orgknow@localhost:5433/orgknow

# Seconds GET /ready waits for a database connection before reporting 503.
DB_CONNECT_TIMEOUT_S=2

# Where `make seed` reads the releases from. Relative to the repo root; the default is the
# committed manifest.
# CORPUS_MANIFEST_PATH=config/corpus_manifest.yaml

# `make test-int` migrates and tests a separate database, `orgknow_test` (created by `make up`),
# so the dev database's ingested rows never collide with test rows. The Makefile holds the
# default; override it in the shell (Make doesn't read this file), as CI does.
# TEST_DATABASE_URL=postgresql://orgknow:orgknow@localhost:5433/orgknow_test

# Where spikes/fetch.py keeps partial clones of the corpus repos; `make ingest` reads them.
# Must be outside this repo. `~` is expanded. spikes/fetch.py reads it only from the shell
# environment (`uv run` doesn't load .env), so export it there too.
# CORPUS_CACHE_DIR=~/corpus_cache/org-knowledge-rag

# The SHAs `make ingest` reads (written by spikes/fetch.py). Relative to the repo root.
# CORPUS_LOCK_PATH=config/corpus_manifest.lock.yaml

# Which `scopes:` entry of the manifest `make ingest` reads.
# INGEST_SCOPE=s04

# KEP claim synonyms (ADR-003 D5): `GA` -> `stable` is the only one. JSON object.
# CLAIM_SYNONYMS={"GA": "stable"}

# The largest chunk body `make ingest` writes, in tokens estimated as characters / 4 (S04-R1
# decision 5). Only versions with no chunks are chunked, so a new value applies to versions
# stored after the change.
# CHUNK_MAX_TOKENS=512

# `make embed` calls the Voyage API with this key (paid). Unset: `make embed` stops with a message.
# Never commit it; tests use a fake embedder and never call Voyage.
# VOYAGE_API_KEY=

# The embeddings endpoint and model. Vectors are stored under the model name, so a new model
# embeds every text again (the old vectors stay).
# VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings
# EMBEDDING_MODEL=voyage-4-large

# One request holds at most this many texts and estimated tokens (characters / 4). A single text
# over the token budget is sent alone.
# EMBED_BATCH_MAX_TEXTS=128
# EMBED_BATCH_MAX_TOKENS=60000

# `make embed` refuses to start when the texts it would send exceed this many estimated tokens.
# EMBED_MAX_TOKENS_PER_RUN=2000000

# How many chunk texts dense retrieval returns per question: 1 to 40 (40 is pgvector's default
# hnsw.ef_search, the most rows an HNSW index scan returns).
# RETRIEVAL_TOP_K=10

# The answer step (ADR-006 D1): the model, its effort (low, medium, high, xhigh or max: how much
# it reasons first) and the most tokens one answer may use, reasoning included (billed as output).
# GENERATION_MAX_TOKENS is 1 to 21333: above that, the SDK refuses a non-streaming call.
# GENERATION_MODEL=claude-opus-5-5
# GENERATION_EFFORT=medium
# GENERATION_MAX_TOKENS=16000

# The answer step calls the Anthropic API with this key (paid). Never commit it; tests use a fake
# generator and never call Anthropic.
# ANTHROPIC_API_KEY=

# Langfuse tracing (ADR-006 D3): `orgknow ask` sends one trace per question to Langfuse Cloud.
# Leave either key unset and `ask` prints "tracing off" and still answers. Never commit the keys;
# tests never call Langfuse. The base URL defaults to the EU region; for the US region use
# https://us.cloud.langfuse.com.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
