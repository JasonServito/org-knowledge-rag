#!/bin/bash
# The server's boot script (S15-T4, plan c1): EC2 runs it once, as root, at the first boot.
# It installs Docker and the ECR credential helper and writes the deploy script, and starts no
# container: the first start is the runbook's `sudo orgknow-deploy <tag>`, after the image, the
# secrets and the database are in place.
# Terraform fills in the $${...} values when it renders this template.
set -euo pipefail

dnf install -y docker amazon-ecr-credential-helper
# Docker starts at every boot, so its restart policy brings both containers back after a reboot.
systemctl enable --now docker

# Root's Docker config: Docker asks the credential helper for this registry's token at each pull,
# so there's no `docker login` and no token in this file (ADR-015 D3). The key is the registry
# host, not the repository URL.
mkdir -p /root/.docker
cat > /root/.docker/config.json <<'JSON'
{"credHelpers": {"${registry}": "ecr-login"}}
JSON

cat > /usr/local/bin/orgknow-deploy <<'DEPLOY'
#!/bin/bash
# orgknow-deploy <image-tag>: (re)start the API and the worker from one image tag (ADR-014 D4),
# migrating the database first (ADR-015 D3). Run it as root. The runbook's first start, its
# updates and S16's deploys all call it. Any failed step stops it with a non-zero exit.
set -euo pipefail
if [ $# -ne 1 ]; then
  echo "usage: orgknow-deploy <image-tag>" >&2
  exit 2
fi
IMAGE="${repository_url}:$1"
REGION="${region}"
# Root's Docker config (the credential helper), found even when Run Command leaves HOME unset.
export DOCKER_CONFIG=/root/.docker
# The helper otherwise caches the registry token on disk, in ~/.ecr (ADR-015 D3: none on disk).
export AWS_ECR_DISABLE_CACHE=true

# 1. Settings and secrets: every /orgknow/* parameter, decrypted, as NAME=value lines with no
#    quotes (what `docker run --env-file` reads), in a file only root can read (D6). The file is
#    made root-only (0600) while still empty, so the secrets are never in a readable file.
mkdir -p /etc/orgknow
install -m 600 /dev/null /etc/orgknow/env
aws ssm get-parameters-by-path --region "$REGION" --path /orgknow --with-decryption \
  --query 'Parameters[*].[Name,Value]' --output text \
  | sed -e 's|^/orgknow/||' -e 's|\t|=|' > /etc/orgknow/env

# 2. The corpus cache (m6): unpacked from the bucket on the first deploy only. It is unpacked
#    into a temporary directory and renamed at the end, so a failed download leaves no partial
#    cache that a later deploy would take as complete.
if [ ! -d /srv/orgknow/corpus_cache ]; then
  rm -rf /srv/orgknow/corpus_cache.tmp
  mkdir -p /srv/orgknow/corpus_cache.tmp
  aws s3 cp --region "$REGION" "s3://${bucket}/corpus_cache.tar.gz" - \
    | tar -xz -C /srv/orgknow/corpus_cache.tmp
  mv /srv/orgknow/corpus_cache.tmp /srv/orgknow/corpus_cache
fi

# 3. The image: pull the tag; the credential helper gets the token (the role may pull this one
#    repository). -q prints one line, so Run Command's output stays short (S16 c5).
docker pull -q "$IMAGE"

# 4. The migration: the old containers are removed, then `alembic upgrade head` runs in a one-off
#    container from the new image (ADR-015 D3). If it fails, set -e stops the script here and
#    nothing new starts; recovery is `orgknow-deploy <previous tag>`. No automatic downgrade.
docker rm -f orgknow-api orgknow-worker 2>/dev/null || true
docker run --rm --env-file /etc/orgknow/env "$IMAGE" alembic upgrade head

# 5. Both containers, run from the new image (the names table's commands).
#    `unless-stopped`: Docker restarts each one after a crash or a reboot (ADR-014 D4).
#    Logs go to CloudWatch, group ${log_group}, one stream each (m9).
docker run -d --name orgknow-api --restart unless-stopped --env-file /etc/orgknow/env \
  --log-driver awslogs --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=api \
  -p 127.0.0.1:8000:8000 \
  "$IMAGE"
docker run -d --name orgknow-worker --restart unless-stopped --env-file /etc/orgknow/env \
  --log-driver awslogs --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group=${log_group} --log-opt awslogs-stream=worker \
  -v /srv/orgknow/corpus_cache:/corpus_cache:ro \
  "$IMAGE" python -m orgknow.ingestion.worker
docker ps --filter name=orgknow-
DEPLOY
chmod 0755 /usr/local/bin/orgknow-deploy
